{
  "type": "package",
  "name": "sjalq/schelm-node-runtime",
  "summary": "Bounded Node runtime, console, clock, signal, ticker, and terminal primitives",
  "license": "BSD-3-Clause",
  "version": "1.0.0",
  "elm-version": "0.19.0 <= v < 0.20.0",
  "exposed-modules": [
    "Schelm.Node.Runtime",
    "Schelm.Node.Runtime.Clock",
    "Schelm.Node.Runtime.Entropy",
    "Schelm.Node.Runtime.Console",
    "Schelm.Node.Runtime.Signal",
    "Schelm.Node.Runtime.Ticker",
    "Schelm.Node.Terminal"
  ],
  "dependencies": {
    "elm/core": "1.0.0 <= v < 2.0.0",
    "elm/bytes": "1.0.0 <= v < 2.0.0",
    "elm/json": "1.0.0 <= v < 2.0.0"
  },
  "test-dependencies": {"elm-explorations/test": "2.2.0 <= v < 3.0.0"}
